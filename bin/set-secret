#!/bin/bash
# Store a secret for this project through a macOS dialog, never a terminal or a chat.
#   bin/set-secret anthropic-key     -> ~/.config/truckee-cares/anthropic-key
#   bin/set-secret openai-key
# Then push it to the Worker with: bin/push-secret anthropic-key ANTHROPIC_API_KEY
set -euo pipefail
NAME="${1:?usage: set-secret <name>}"
DIR="$HOME/.config/truckee-cares"; mkdir -p "$DIR"; chmod 700 "$DIR"
VAL=$(osascript -e "text returned of (display dialog \"Paste the value for $NAME (Truckee Cares):\" default answer \"\" with hidden answer with title \"Truckee Cares\")" 2>/dev/null || true)
[ -n "$VAL" ] || { echo "cancelled"; exit 1; }
umask 077; printf '%s\n' "$VAL" > "$DIR/$NAME"
echo "stored $DIR/$NAME (mode 600)"
