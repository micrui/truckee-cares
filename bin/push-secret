#!/bin/bash
# Upload a stored secret file to the Worker without it ever appearing on screen.
#   bin/push-secret anthropic-key ANTHROPIC_API_KEY
set -euo pipefail
cd "$(dirname "$0")/.."
FILE="$HOME/.config/truckee-cares/${1:?usage: push-secret <file-name> <WORKER_SECRET_NAME>}"
[ -s "$FILE" ] || { echo "no such secret file: $FILE (run bin/set-secret $1)"; exit 1; }
npx wrangler secret put "${2:?}" --config worker/wrangler.toml < "$FILE"
